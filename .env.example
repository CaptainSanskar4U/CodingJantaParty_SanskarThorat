# Dhvani local configuration. Copy to .env and edit if needed.

# --- Authentication -------------------------------------------------------
# 1 = session login required. 0 = local-only demo mode (no login).
DHVANI_AUTH=1
DHVANI_DEMO_USER=mehta
DHVANI_DEMO_PASSWORD=dhvani-demo
DHVANI_DEMO_NAME=Inspector Mehta
DHVANI_DEMO_ROLE=Investigator
ORBITWIN_AUTH=1
ORBITWIN_DEMO_USER=mehta
ORBITWIN_DEMO_PASSWORD=dhvani-demo
ORBITWIN_DEMO_NAME=Inspector Mehta
ORBITWIN_DEMO_ROLE=Investigator

# --- Local AI --------------------------------------------------------------
# faster-whisper models. base is fast; small is more accurate for Hindi.
WHISPER_MODEL=base
WHISPER_HINDI_MODEL=small
AUDIO_EVENT_MODEL=MIT/ast-finetuned-audioset-10-10-0.4593
EMOTION_MODEL=superb/wav2vec2-base-superb-er

# --- Files / limits --------------------------------------------------------
MAX_UPLOAD_MB=50
MAX_DURATION_SECONDS=300

# --- Optional Gemini live transcription -----------------------------------
# Server-side only. Never put this key in static/app.js or the HTML.
# Live mode sends only short microphone chunks to Gemini for provisional text;
# the final analysis and evidence remain local.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TIMEOUT_SECONDS=45
# Near-real-time defaults: one 5-second chunk every 5 seconds, max 5 minutes.
LIVE_CHUNK_SECONDS=5
LIVE_MAX_SECONDS=300
LIVE_MAX_CHUNK_MB=8
LIVE_RATE_LIMIT_PER_MINUTE=12

# --- Map / geocoding -------------------------------------------------------
MAP_TILE_URL=https://server.arcgisonline.com/ArcGIS/rest/services/World_Imagery/MapServer/tile/{z}/{y}/{x}
MAP_ATTRIBUTION=Tiles &copy; Esri
NOMINATIM_URL=https://nominatim.openstreetmap.org
NOMINATIM_USER_AGENT=Orbitwin-Hackathon/1.0 (local investigation demo)

# --- Telephony (not configured by default) --------------------------------
# Orbitwin does not claim a live telephony connection unless these are set
# and a real provider adapter has been implemented for your account.
TELEPHONY_PROVIDER=none
TELEPHONY_ACCOUNT_SID=
TELEPHONY_AUTH_TOKEN=
TELEPHONY_FROM_NUMBER=
